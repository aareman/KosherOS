# Kosher Linux OS image — a thin, locked-down layer over Fedora bootc.
# Build:  just build      Fresh VM disk:  just vm      Update a RUNNING VM:  just vm-upgrade

# --- Builder: GNOME Shell extensions Fedora does not package -------------------
# ArcMenu is the classic layout's start menu (the button that says "Apps").
# It needs glib-compile-resources and gettext to build, neither of which
# belongs in the shipped image, so it is built here from a pinned tag and
# only the result is copied over. A failed fetch leaves a marker rather than
# failing the whole image; the final stage warns and ships without it.
# Lowercase "as": the podman on GitHub's Ubuntu runners (4.9) rejects "AS"
# with "FROM requires either one argument, or three".
FROM quay.io/fedora/fedora:44 as gnome-ext-build
ARG ARCMENU_REF=v69.2
RUN dnf -y install glib2-devel gettext make git-core && dnf clean all
RUN mkdir -p /out && ( git clone --depth 1 --branch "${ARCMENU_REF}" \
        https://gitlab.com/arcmenu/ArcMenu /tmp/arcmenu \
    && make -C /tmp/arcmenu install DESTDIR=/out \
    && grep -q '"50"' /out/usr/share/gnome-shell/extensions/arcmenu@arcmenu.com/metadata.json \
    || { echo "WARNING: ArcMenu did not build"; rm -rf /out/usr; touch /out/FAILED; } )

FROM quay.io/fedora/fedora-bootc:44

# --- Packages ---------------------------------------------------------------
# GNOME desktop + our runtime deps. Remove escape hatches (toolbox/container
# tooling is attack-surface hygiene; the skuid firewall holds regardless).
# dnf5 can't mix a @group with plain packages in one install, hence two calls.
RUN dnf -y install --exclude=toolbox --exclude=podman @workstation-product-environment && dnf clean all
RUN dnf -y install dnsmasq nftables python3-gobject python3-jsonschema python3-pip \
        malcontent malcontent-tools flatpak accountsservice cage \
        ca-certificates \
        # greenboot: if a new image boots without the filter coming up, the
        # machine puts ITSELF back. A locked-down computer that fails to
        # boot properly is a family with no computer and no way in, so the
        # update path needs a floor that does not depend on anyone being
        # around to notice. See files/etc/greenboot/check/required.d/.
        greenboot \
        # The desktop layouts (docs/desktop.md). Classic: GNOME with a
        # taskbar (Dash to Panel) and tray icons; tiling adds PaperWM, which
        # Fedora does not package, so it is fetched below. Advanced: a
        # separate niri session with the Noctalia shell, plus the portal
        # backend Flatpak apps need outside GNOME.
        gnome-shell-extension-dash-to-panel gnome-shell-extension-appindicator \
        niri noctalia xdg-desktop-portal-gtk \
        # Hebrew, properly: the Culmus family (David, Frank Ruehl, Hadasim,
        # Miriam, Nachlieli, Taamey Frank with te'amim), Noto Sans/Serif
        # Hebrew, Noto Rashi for sefarim, Ezra SIL for Tanach with
        # cantillation, Alef and Plex Sans Hebrew for screen text. A machine
        # for a family that types Hebrew ships the fonts; nobody should have
        # to find them.
        culmus-fonts-all google-noto-sans-hebrew-vf-fonts \
        google-noto-serif-hebrew-vf-fonts google-noto-rashi-hebrew-vf-fonts \
        sil-ezra-fonts alef-fonts ibm-plex-sans-hebrew-fonts \
        && dnf clean all \
    # The proxy runs unprivileged; kosherd hands it only the URL rules.
    && useradd -r -s /usr/sbin/nologin -d /var/lib/kosher-mitm kosher-mitm \
    # Same for search: the front end and the engine behind it run as one
    # unprivileged user and are given only what they filter with.
    && useradd -r -s /usr/sbin/nologin -d /var/lib/kosher-search kosher-search \
    # Both services may drop an "ask for this page" request into the
    # spool; neither may read it back. See tmpfiles.d/kosher.conf.
    && groupadd -r kosher-spool \
    && usermod -aG kosher-spool kosher-mitm \
    && usermod -aG kosher-spool kosher-search
# sudo is on dnf's protected list; removing it here is the whole point.
# podman must STAY: bootc (the update mechanism) depends on it in F44+. The
# skuid firewall contains rootless containers, and SUB_UID_COUNT=0 below
# denies new users subordinate IDs anyway.
RUN for p in sudo toolbox gnome-boxes gnome-software PackageKit \
        PackageKit-command-not-found gnome-initial-setup gnome-classic-session; do \
        rpm -q "$p" >/dev/null 2>&1 && dnf -y --setopt=protected_packages= remove "$p"; \
    done; \
    ! rpm -q sudo && rpm -q bootc

# Build/branding tooling in one early layer, so the later steps that use it
# are cheap and local. Layer ORDER in this file is deliberate: the heavy,
# rarely-changing work (package installs, pip wheels, the SearXNG clone,
# the multi-minute category download) comes first, and the things that
# change every day — unit files, configs, our code — come last. Before
# this, `COPY os-image/files/ /` sat near the top, so editing one systemd
# unit re-downloaded the entire category database and every wheel.
RUN dnf -y install checkpolicy policycoreutils policycoreutils-python-utils \
        librsvg2-tools plymouth-plugin-script dconf git-core && dnf clean all

# --- Heavy, stable artifacts (network; change ~never) -------------------------
# PaperWM, the tiling layout's extension, is not packaged by Fedora. A
# pinned release goes in as a SYSTEM extension: under /usr no account can
# remove it, and kosher-layout can enable it for any account. Its uuid is
# what layout.py enables, so the directory must carry that exact name; the
# schema is compiled in place, which is where GNOME Shell looks for an
# extension's own settings.
ARG PAPERWM_REF=v50.0.1
RUN d=/usr/share/gnome-shell/extensions/paperwm@paperwm.github.com \
    && git clone --depth 1 --branch "${PAPERWM_REF}" \
        https://github.com/paperwm/PaperWM "$d" \
    && rm -rf "$d/.git" \
    && glib-compile-schemas "$d/schemas" \
    && grep -q '"50"' "$d/metadata.json" \
    || echo "WARNING: PaperWM did not install; the tiling layout will be plain GNOME"
# ArcMenu, from the builder stage above. Its schema lands in the shared
# schema directory (that is how its Makefile installs system-wide), so the
# compiled schema cache is refreshed for GNOME Shell to find it.
COPY --from=gnome-ext-build /out/ /tmp/gnome-ext/
RUN if [ -e /tmp/gnome-ext/FAILED ]; then \
        echo "WARNING: no ArcMenu; the classic layout falls back to Dash to Panel's apps button"; \
    else \
        cp -a /tmp/gnome-ext/usr/. /usr/ \
        && glib-compile-schemas /usr/share/glib-2.0/schemas; \
    fi; rm -rf /tmp/gnome-ext

# mitmproxy is not packaged for Fedora 44, so install it from PyPI (with its
# dependencies — unlike our own packages, which are --no-deps).
RUN python3 -m pip install --prefix=/usr mitmproxy
# The image detector: NudeNet's ONNX model is about 5 MB and runs on the
# CPU in tens of milliseconds, which is the only kind of model that fits a
# product whose premise is that it works on a weak machine with nothing
# leaving the house. onnxruntime and Pillow come with it; Pillow is also
# what covers a detected region instead of blanking the whole picture.
RUN python3 -m pip install --prefix=/usr nudenet onnxruntime pillow \
    || echo "WARNING: no image model; picture filtering will hide pictures"
# A person detector beside it (kosherd/persons.py): the nudity model labels
# parts and has no class for legs, so a skirt photographed from the hips
# down came back empty. YOLOX-Nano says where the figure is, and the skin
# measurement runs on that. 3.5 MB, Apache-2.0, ~40 ms on a laptop CPU.
# Pinned by hash: a model is code that runs on every picture a child sees.
RUN mkdir -p /usr/share/kosher/models \
    && curl -fsSL -o /usr/share/kosher/models/yolox_nano.onnx \
         https://github.com/Megvii-BaseDetection/YOLOX/releases/download/0.1.1rc0/yolox_nano.onnx \
    && echo "c789161ed43c8269fcd4e67c67eeeb4e80c622da2eb296a20bc6007bd18a0b7d  /usr/share/kosher/models/yolox_nano.onnx" | sha256sum -c -
# PyAV: FFmpeg's libraries as a wheel, with the H.264, VP9 and AV1 decoders
# that Fedora's own ffmpeg-free leaves out. The proxy samples a few
# keyframes from a clip and judges them like pictures (kosherd/videocheck).
# Without it, filtered accounts get no open-web video, as before.
RUN python3 -m pip install --prefix=/usr av \
    || echo "WARNING: no video decoder; filtered accounts will get no open-web video"
# SearXNG is the metasearch engine behind our search page. It is a large
# dependency and the only reason it is here is that scraping search
# engines is the part that breaks constantly, and SearXNG is the project
# that keeps up with it. Everything version-specific stays behind its JSON
# API, which is stable, so an upgrade cannot reach our filtering.
#
# From git, and from a source tree rather than a wheel. The name "searxng"
# on PyPI belongs to an unrelated project, and `pip install` of the repo
# fails outright: its setup.py imports searx/__init__.py, which imports
# msgspec before anything is installed. Upstream's own instructions are to
# clone and install requirements.txt, which is what this does; the unit
# runs it with PYTHONPATH pointing at the tree.
# TODO(stage 2): pin a commit rather than tracking master, so an image
# rebuild is reproducible.
ARG SEARXNG_REF=master
RUN git clone --depth 1 --branch "${SEARXNG_REF}" \
        https://github.com/searxng/searxng /usr/share/kosher/searxng-src \
    && python3 -m pip install --prefix=/usr \
        -r /usr/share/kosher/searxng-src/requirements.txt \
    && rm -rf /usr/share/kosher/searxng-src/.git \
    || echo "WARNING: SearXNG did not install; search will be unavailable"

# The category database is built here rather than committed: a family must
# not have to assemble lists, and the shipped JSON seed is only a fallback
# for a build with no network. Millions of domains in SQLite cost a few MB
# of page cache to query; the same data in a dict would cost hundreds of MB
# of RAM on exactly the low-end machine this has to run on.
COPY scripts/fetch-categories.py scripts/curated-sites.json /tmp/
RUN python3 /tmp/fetch-categories.py \
        --out /usr/share/kosher/categories/categories.sqlite \
    || echo "WARNING: category import failed; falling back to the seed list"
RUN rm -f /tmp/fetch-categories.py /tmp/curated-sites.json

# Third-party sources are enabled outright rather than prompted for: the
# catalog allowlist already decides what may be installed, so asking the
# person setting up a family computer to rule on repositories is a question
# with no useful answer.
RUN fedora-third-party enable && fedora-third-party query

# Flathub is the SOURCE of apps; the catalog allowlist (+ the remote filter
# kosherd renders from it) decides what may actually be installed, and only
# kosherd may install at all.
RUN flatpak remote-add --system --if-not-exists \
        flathub https://dl.flathub.org/repo/flathub.flatpakrepo

# --- Static configuration (units, polkit, dbus, dnsmasq, baseline firewall) --
COPY os-image/files/ /

# SELinux: dnsmasq needs a netfilter netlink socket to feed the nft whitelist
# sets (not covered by Fedora's stock dnsmasq policy).
RUN true && \
    # The plain resolver for unfiltered users listens on 5354, which SELinux
    # does not know is DNS; without this dnsmasq cannot bind it at all.
    (semanage port -a -t dns_port_t -p udp 5354 || \
     semanage port -m -t dns_port_t -p udp 5354) && \
    (semanage port -a -t dns_port_t -p tcp 5354 || \
     semanage port -m -t dns_port_t -p tcp 5354) && \
    checkmodule -M -m -o /tmp/kosher-dnsmasq-nftset.mod /usr/share/kosher/selinux/kosher-dnsmasq-nftset.te && \
    semodule_package -o /tmp/kosher-dnsmasq-nftset.pp -m /tmp/kosher-dnsmasq-nftset.mod && \
    semodule -i /tmp/kosher-dnsmasq-nftset.pp && rm -f /tmp/kosher-dnsmasq-nftset.*

# --- Lockdown ----------------------------------------------------------------
# Identity: KosherOS, powered by Fedora (Fedora Remix terms). ID stays
# "fedora" — tooling keys off it; only the human-facing names change.
# One version number for the whole product: the repo's VERSION file names
# the release in os-release, in the installer's welcome screen, and in the
# ISO's file name (scripts/brand-iso.py reads the same file).
COPY VERSION /usr/share/kosher/VERSION
RUN . /usr/lib/os-release \
    && kosher_version="$(tr -d '[:space:]' < /usr/share/kosher/VERSION)" \
    && sed -i \
        -e 's/^NAME=.*/NAME="KosherOS"/' \
        -e "s/^PRETTY_NAME=.*/PRETTY_NAME=\"KosherOS ${kosher_version} (powered by Fedora ${VERSION_ID})\"/" \
        -e '/^VARIANT=/d' -e '/^VARIANT_ID=/d' \
        /usr/lib/os-release \
    && printf 'VARIANT="KosherOS"\nVARIANT_ID=kosheros\n' >> /usr/lib/os-release \
    # DEFAULT_HOSTNAME is the fallback systemd uses when /etc/hostname is
    # absent or empty, and Fedora sets it to "fedora". The hostname file
    # itself is shipped by COPY, not written here: podman bind-mounts
    # /etc/hostname over the build container, so `echo > /etc/hostname` in
    # a RUN writes to a temporary file and the image keeps an empty one.
    # That is exactly what happened, and the machine introduced itself as
    # "fedora login:" at every prompt.
    && sed -i '/^DEFAULT_HOSTNAME=/d' /usr/lib/os-release \
    && echo 'DEFAULT_HOSTNAME=kosheros' >> /usr/lib/os-release

# --- Branding: boot splash, login screen, wallpaper, GRUB --------------------
COPY branding/ /usr/share/kosher/branding/
# Every raster from the real artwork (branding/logo.png, wallpaper.png):
# the boot-splash logo, the start button, the login-screen lockup with the
# name beside the logo, the wallpaper and its per-screen-shape crops plus
# the background XML that lets GNOME pick the right one. See the script.
RUN python3 /usr/share/kosher/branding/rasters.py \
    # The admin app's icon went into hicolor; refresh the cache GTK reads.
    && gtk-update-icon-cache -f -t /usr/share/icons/hicolor \
    # The GRUB theme rasters.py wrote under /usr/lib/efi is a bootupd
    # component: regenerate bootupd's EFI manifest so it is carried onto
    # the EFI system partition at install, and assert it was picked up —
    # a theme that quietly never reaches the disk is a plain menu with no
    # error anywhere.
    && bootupctl backend generate-update-metadata \
    && grep -q kosheros-grub-theme /usr/lib/bootupd/updates/EFI.json \
    && test -f /usr/share/grub/themes/starfield/theme.txt
RUN true \
    # The SVG is the older placeholder gradient, kept for anything still
    # pointing at it. The GIMP sources travel in the repo, not in the image.
    && install -D -m644 /usr/share/kosher/branding/wallpaper.svg \
         /usr/share/backgrounds/kosheros/kosheros.svg \
    && rm -f /usr/share/kosher/branding/*.xcf \
    # Boot progress bar: Plymouth's script language cannot draw solid
    # colours, so the bar is two images the theme scales.
    && rsvg-convert -w 200 -h 8 /usr/share/kosher/branding/bar-track.svg \
         -o /usr/share/plymouth/themes/kosheros/bar-track.png \
    && rsvg-convert -w 200 -h 8 /usr/share/kosher/branding/bar-fill.svg \
         -o /usr/share/plymouth/themes/kosheros/bar-fill.png \
    && plymouth-set-default-theme kosheros \
    # bootc images have no /etc/default/grub; create it for the menu title.
    # (The timeout GRUB actually uses is set in the static config,
    # configs.d/09_kosheros_quiet.cfg; this file is documentation.)
    && printf 'GRUB_DISTRIBUTOR="KosherOS"\nGRUB_TIMEOUT=1\nGRUB_TIMEOUT_STYLE=hidden\n' > /etc/default/grub \
    # No systemd.show_status: it surfaced "Starting Plymouth…" and unit
    # names on the splash, which is not a sentence a family should have to
    # read. Our own units say what is happening instead, in plain words,
    # through `plymouth display-message` (see the *.service.d/10-kosheros-
    # splash.conf drop-ins), and the theme opens on "Starting KosherOS…".
    # The rest keep the text console blank:
    # between the login screen and the desktop (and back, at sign-out) the
    # display falls to the kernel console for a moment, and what it showed
    # there was kernel and audit chatter with a blinking cursor. A quiet
    # console at loglevel 3 and no cursor makes that moment a plain dark
    # screen, which is the most a kernel console can be asked to be.
    && mkdir -p /usr/lib/bootc/kargs.d \
    && printf 'kargs = ["quiet", "loglevel=3", "vt.global_cursor_default=0", "rd.udev.log_level=3", "udev.log_priority=3"]\n' \
         > /usr/lib/bootc/kargs.d/10-kosheros.toml \
    # The three device-security checks an operating system can answer for.
    # GNOME's Device Security panel reports fwupd's Host Security ID, and
    # most of that score is the firmware's: Secure Boot, the TPM, VT-d and
    # the firmware revision are the owner's settings, and BootGuard, SPI
    # write protection, the ME's manufacturing mode and the CPU's CET and
    # SMAP are the vendor's. These three are ours.
    #
    #   lockdown=integrity  the kernel refuses the paths that would let root
    #                       rewrite the running kernel. It engages under
    #                       Secure Boot by itself; saying so explicitly means
    #                       a machine booted without it still gets the same
    #                       floor, which is this product's whole posture.
    #   intel_iommu=on      devices are behind the IOMMU. Modern kernels do
    #                       this where the firmware exposes VT-d; older
    #                       Intel parts need asking, and it costs nothing
    #                       where it is already on.
    #   mem_sleep_default=s2idle
    #                       suspend to idle rather than deep S3, which fwupd
    #                       marks down because S3 leaves the memory image
    #                       where firmware attacks can reach it.
    #
    # Nothing here loads an out-of-tree module (no proprietary drivers ship,
    # and none can be installed), so lockdown costs the family nothing.
    && printf 'kargs = ["lockdown=integrity", "intel_iommu=on", "mem_sleep_default=s2idle"]\n' \
         > /usr/lib/bootc/kargs.d/20-kosheros-security.toml \
    && dconf update


RUN passwd -l root \
    && groupadd -r kosher-admin \
    && sed -i -e 's/^SUB_UID_COUNT.*/SUB_UID_COUNT 0/' -e 's/^SUB_GID_COUNT.*/SUB_GID_COUNT 0/' /etc/login.defs \
    && systemctl mask systemd-resolved.service debug-shell.service \
    && systemctl enable sshd.service \
    && systemctl enable kosherd.service kosher-firewall.service kosher-dns.service \
    && systemctl enable bootc-fetch-apply-updates.timer \
    # An update that boots without the filter puts itself back. greenboot's
    # own [Install] carries Also=greenboot-set-rollback-trigger.service, so
    # enabling the health check arms the rollback too — verified against
    # the unit in fedora-bootc:44 rather than assumed. is-enabled is the
    # assertion: if a future greenboot renames these, the BUILD fails
    # rather than a machine shipping with no floor under its updates.
    && chmod 0755 /etc/greenboot/check/required.d/10-kosher-filter.sh \
    && systemctl enable greenboot-healthcheck.service \
    && systemctl is-enabled greenboot-healthcheck.service \
    && systemctl is-enabled greenboot-set-rollback-trigger.service \
    && rm -f /etc/flatpak/remotes.d/*.flatpakrepo

# Only images signed for our registry may be switched/updated to.
# TODO(stage 2): replace with sigstoreSigned policy for the real registry:
#   /etc/containers/policy.json + /etc/containers/registries.d/kosher.yaml


# --- kosherd + apps (last layers: change most often) --------------------------
COPY kosherd/ /tmp/kosherd/
COPY search-app/ /tmp/search-app/
COPY admin-app/ /tmp/admin-app/
COPY store-app/ /tmp/store-app/
COPY setup-app/ /tmp/setup-app/
COPY myfilter-app/ /tmp/myfilter-app/
COPY policy/schema/policy.schema.json /usr/share/kosher/policy.schema.json
COPY mitm/ /usr/share/kosher/mitm/

# Validate OUR settings against the SearXNG that just landed, and fail the
# build if they do not agree. Both halves of this caught a real bug that
# had already shipped: an invalid `preferences.lock` entry stopped the
# engine starting at all, and disabling an engine SearXNG does not have
# does not disable anything — it defines a broken one.
COPY scripts/check-searxng-settings.py /tmp/check-searxng-settings.py
RUN SEARXNG_SETTINGS_PATH=/usr/share/kosher/searxng/settings.yml \
    PYTHONPATH=/usr/share/kosher/searxng-src python3 /tmp/check-searxng-settings.py \
    && rm /tmp/check-searxng-settings.py
RUN python3 -m pip install --prefix=/usr --no-deps \
        /tmp/kosherd/ /tmp/admin-app/ /tmp/store-app/ /tmp/setup-app/ \
        /tmp/search-app/ /tmp/myfilter-app/ \
    && rm -rf /tmp/kosherd /tmp/admin-app /tmp/store-app /tmp/setup-app \
        /tmp/search-app /tmp/myfilter-app \
    && chmod 755 /usr/bin/kosher-setup-session \
    && systemctl enable kosher-firstboot.service \
    # Every graphical sign-in applies that account's desktop layout.
    && systemctl --global enable kosher-layout.service \
    # ...and listens for kosherd's time warnings, so "5 minutes left" is a
    # notification on the person's screen, not a line in a log.
    && systemctl --global enable kosher-time-notify.service \
    && systemctl enable kosher-search-secret.service kosher-searxng.service \
        kosher-search.service \
    # Portal sync is inert until the device enrols (the unit and timer
    # both carry ConditionPathExists on the enrolment file).
    && systemctl enable kosher-sync.timer

# Time limits at the door. kosherd renders /etc/security/time.conf from
# the policy (when each account may sign in; an account whose daily time
# is used up is refused outright); pam_time in the account stack is what
# reads it. It goes into the login-screen and console services directly —
# password-auth is authselect's, and editing that file breaks `authselect
# check`. On a refusal, pam_exec notes it in the activity log so the
# parent sees "sign-in refused, 21:14" beside everything else.
RUN for f in gdm-password gdm-autologin login; do \
        [ -f "/etc/pam.d/$f" ] && ! grep -q pam_time "/etc/pam.d/$f" && \
        sed -i '0,/^account/{s|^account|account    [success=1 default=bad] pam_time.so\naccount    optional pam_exec.so quiet /usr/bin/kosher-time-refused\n&|}' "/etc/pam.d/$f"; \
    done \
    && grep -q pam_time /etc/pam.d/gdm-password \
    && grep -q kosher-time-refused /etc/pam.d/gdm-password \
    && test -x /usr/bin/kosher-time-refused \
    && test -x /usr/bin/kosher-time-notify

# The identity has to survive the build, not just be written during it.
#
# Note what is NOT checked here: /etc/hostname. The container engine
# bind-mounts that file over the build container, so a RUN can neither
# write it (which is how it ended up empty and the machine called itself
# "fedora") nor read what COPY put in the layer. Checking it here would
# fail on a correct image. It is asserted against the build context by
# the test suite instead, and DEFAULT_HOSTNAME below is the belt to its
# braces: systemd falls back to it whenever /etc/hostname is missing or
# empty, which is exactly the case that bit us.
RUN grep -q '^DEFAULT_HOSTNAME=kosheros' /usr/lib/os-release \
    && grep -q '^NAME="KosherOS"' /usr/lib/os-release \
    && grep -q '^VARIANT_ID=kosheros' /usr/lib/os-release \
    && echo "identity ok"

# bootc images must pass a container lint.
RUN bootc container lint

# --- The version, where bootc reads it ---------------------------------------
# `bootc status` and `bootc upgrade --check` take their "Version:" from the
# org.opencontainers.image.version label, and the base image carries
# Fedora's. Without ours, the admin app could say an update was available
# but never which one, and the running version was the image reference.
# Last, so a new number does not invalidate the layers above it: an ARG
# breaks the cache from its first use, not its declaration.
ARG KOSHER_VERSION=local
LABEL org.opencontainers.image.version="${KOSHER_VERSION}"
