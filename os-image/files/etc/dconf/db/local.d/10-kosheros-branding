# KosherOS desktop branding defaults (dconf; see also 10-kosheros-locks).
# The XML, not the PNG: it lists a crop per screen shape, each keeping the
# wordmark in the top-left corner, and gnome-bg picks the one that matches
# the screen. "zoom" on the single 3:2 picture cropped from the centre and
# cut the word off on 16:9 and 4:3 screens. See branding/rasters.py.
[org/gnome/desktop/background]
picture-uri='file:///usr/share/backgrounds/kosheros/kosheros.xml'
picture-uri-dark='file:///usr/share/backgrounds/kosheros/kosheros.xml'
picture-options='zoom'
primary-color='#0b1a33'

[org/gnome/desktop/screensaver]
picture-uri='file:///usr/share/backgrounds/kosheros/kosheros.xml'
picture-options='zoom'
primary-color='#0b1a33'

[org/gnome/login-screen]
# A small logo: GDM draws it at native size next to the login controls, and
# a large one overlaps the account hints (e.g. "you need to set a password
# at first login"). No banner message — the logo is the branding.
logo='/usr/share/pixmaps/kosheros-logo-login.png'
disable-user-list=false
banner-message-enable=false

[org/gnome/desktop/interface]
# Light by default, to match the wizard and login screen — the
# "airy cloud" look. A preference, not locked: a user may switch to dark.
color-scheme='default'

[org/gnome/shell]
favorite-apps=['org.mozilla.firefox.desktop', 'org.kosherlinux.Store.desktop', 'org.gnome.Nautilus.desktop', 'org.gnome.Settings.desktop']
