# The classic desktop, as the machine-wide default (see also 10-kosheros-
# branding and locks/10-kosheros-locks).
#
# These are what an account gets before kosher-layout has run for it and
# what any account with no layout of its own gets: a taskbar along the
# bottom with a start button, minimise buttons on windows, no hot corner.
# What a Windows, Mac or ChromeOS user already knows. Workspaces are left
# as GNOME has them, dynamic (#132). kosher-layout writes the per-account variation (the tiling layout)
# into the person's own settings at sign-in; the keys it writes are listed
# in kosherd/layout.py and must not be locked here.

[org/gnome/shell]
enabled-extensions=['dash-to-panel@jderose9.github.com', 'arcmenu@arcmenu.com', 'appindicatorsupport@rgcjonas.gmail.com', 'blur-my-shell@aunetx', 'user-theme@gnome-shell-extensions.gcampax.github.com']
# Extensions come with the image. Shell code fetched from the internet is
# not something a family computer needs, and a broken one takes the whole
# desktop down with it. Locked: the same answer for every account.
allow-extension-installation=false
# GNOME's "Welcome to GNOME" dialog explains GNOME and offers a tour of
# it. KosherOS has its own welcome (kosher-welcome, from an autostart
# entry) that explains this computer, differently to an administrator and
# to a managed user. The Shell shows its dialog when this is below the
# running version; a version it will not reach, locked for every account.
welcome-dialog-last-shown-version='99'

[org/gnome/shell/extensions/dash-to-panel]
# GNOME opens the Activities overview on an empty session; a person who
# just signed in should see their desktop, not a search box.
hide-overview-on-startup=true
# The start button is ArcMenu's (below), which takes the place of this
# one when both are enabled. Should ArcMenu be missing from a build, this
# is the fallback: the Bais Hamikdosh on Dash to Panel's own apps button.
show-apps-icon-file='/usr/share/pixmaps/kosheros-home.png'
show-apps-icon-side-padding=10
# Group windows of one app under one icon and cycle them on click, the
# way the Windows taskbar does; previews on hover so a group is legible.
group-apps=true
show-window-previews=true
# A compact taskbar flush with the bottom and sides of the screen, the way
# a Windows taskbar sits, with a solid enough tint to remain legible
# without blur. It once floated on a margin with rounded outer corners;
# the gap under it read as a mistake on a real laptop, so no margin.
panel-size=48
panel-top-bottom-margins=0
panel-side-margins=0
panel-side-padding=6
appicon-margin=4
appicon-padding=6
global-border-radius=10
highlight-appicon-hover-border-radius=10
tray-padding=6
status-icon-padding=6
trans-use-custom-bg=true
trans-bg-color='#0b1a33'
trans-use-custom-opacity=true
trans-panel-opacity=0.88
trans-use-dynamic-opacity=false
trans-use-border=true
trans-border-width=1
trans-border-use-custom-color=true
trans-border-custom-color='rgba(210,225,245,0.16)'
dot-style-focused='DASHES'
dot-style-unfocused='DOTS'
dot-color-override=true
dot-color-1='#8bb8ff'
dot-color-2='#8bb8ff'
dot-color-3='#8bb8ff'
dot-color-4='#8bb8ff'
focus-highlight-color='#8bb8ff'
focus-highlight-opacity=18
highlight-appicon-hover-background-color='rgba(210,225,245,0.12)'
highlight-appicon-pressed-background-color='rgba(210,225,245,0.20)'

[org/gnome/shell/extensions/arcmenu]
# The start menu. A picture alone does not say "this is where the apps
# are" to someone who has never seen it, so the button is the Bais
# Hamikdosh AND the word "Apps", on a filled pill so it stands out from the
# taskbar's other icons. The Windows-style layout: pinned apps, an
# all-apps list, search — what most people's hands already know.
menu-button-appearance='Icon_Text'
menu-button-text='Apps'
# The front of the Bais Hamikdosh in the brand blue, not the KosherOS mark:
# the mark is the admin app's icon, and on the taskbar it read as "admin"
# rather than "your apps". The pill is cream so the blue and the word stand on it.
menu-button-icon='/usr/share/pixmaps/kosheros-home.png'
menu-button-icon-size=24
menu-button-padding=6
menu-button-bg-color=(true, 'rgba(250,247,240,0.96)')
menu-button-hover-bg-color=(true, 'rgba(255,255,255,1.0)')
menu-button-fg-color=(true, 'rgb(29,78,216)')
menu-button-border-radius=(true, 10)
menu-layout='windows'
hide-overview-on-startup=true
show-activities-button=false

[org/gnome/desktop/wm/preferences]
button-layout='appmenu:minimize,maximize,close'

[org/gnome/mutter]
edge-tiling=true

[org/gnome/desktop/interface]
enable-hot-corners=false

[org/gnome/settings-daemon/plugins/housekeeping]
# GNOME asks for a donation to the GNOME Foundation twice a year, as a
# notification. On a family computer that reads as a strange pop-up asking
# for money — "weird pop up i just got" — and it is not this product's
# appeal to make. Off, and locked, like Debian and Ubuntu ship it.
donation-reminder-enabled=false
