// Kosher Linux: there are NO polkit admin identities for stock actions.
// Every stock action that defaults to auth_admin (adding flatpak remotes,
// rpm-ostree rebase, NetworkManager system changes, ...) becomes
// unsatisfiable. Admin capability exists ONLY through the org.kosherlinux.*
// actions mediated by kosherd — and for those, and those alone, the
// kosher-admin group are the administrators, so that the admin app opened
// on an account that is not an administrator's can be unlocked with an
// administrator's password (49-kosher-admin.rules) rather than showing a
// prompt nothing could satisfy.
polkit.addAdminRule(function(action, subject) {
    if (action.id.indexOf("org.kosherlinux.") === 0) {
        return ["unix-group:kosher-admin"];
    }
    return [];
});
