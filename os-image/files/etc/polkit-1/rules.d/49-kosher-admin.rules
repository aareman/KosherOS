// The entire admin privilege surface of the system: the org.kosherlinux.*
// actions, mediated by kosherd.
//
// An administrator signed in at this computer is not asked for a password.
// Signing in was the proof; asking again for each setting — or once per
// sitting — taught the person who set the computer up that their own
// machine did not trust them. Anyone else at the keyboard (the admin app
// opened on a child's account, say) is asked for an administrator's
// password, which polkit keeps for the sitting and kosherd's own session
// extends as a sliding window (see session.py). Nothing here is reachable
// from a remote or inactive session.
polkit.addRule(function(action, subject) {
    if (action.id.indexOf("org.kosherlinux.") !== 0 ||
        !(subject.active && subject.local)) {
        return polkit.Result.NOT_HANDLED;
    }
    if (subject.isInGroup("kosher-admin")) {
        return polkit.Result.YES;
    }
    // Reads of one's own settings and the app store are free for every
    // account — an explicit answer, so the prompt below never catches them.
    if (action.id === "org.kosherlinux.use-store" ||
        action.id === "org.kosherlinux.read-own-settings") {
        return polkit.Result.YES;
    }
    return polkit.Result.AUTH_ADMIN_KEEP;
});
