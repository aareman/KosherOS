[Unit]
Description=KosherOS first-boot setup wizard
# Runs INSTEAD of the login screen while no admin account exists: a freshly
# installed machine has no user to log in as. kosherd closes the setup API
# once the wizard finishes, and FinishSetup disables this unit.
Before=gdm.service
After=kosherd.service systemd-user-sessions.service
# NOT After=plymouth-quit-wait.service: that unit blocks until Plymouth
# exits, Plymouth exits when the display manager takes over, and GDM is
# ordered after this wizard — so waiting on it deadlocks the boot at
# "job plymouth-quit-wait". Conflicts= cancels that wait instead, and the
# session script tells Plymouth to quit before it needs the console.
Conflicts=plymouth-quit-wait.service
# The wizard and a getty cannot share a console. Without this,
# serial-getty@ttyS0 came up alongside the wizard, both read the same
# device, and the password being typed into the wizard landed at a login
# prompt instead — the wizard printed its questions and never saw an
# answer. Ordering alone is not enough: a getty instance is pulled in by
# getty.target and is not ordered after other units that precede the
# target, so each console getty has to be named.
Before=getty.target getty@tty1.service serial-getty@ttyS0.service serial-getty@hvc0.service
Conflicts=getty@tty1.service serial-getty@ttyS0.service serial-getty@hvc0.service
# Wants, not Requires: the wizard needs the daemon up (After= sees to the
# order), but a daemon restart must not take the wizard down with it.
Wants=kosherd.service
ConditionPathExists=!/var/lib/kosher/setup-complete

[Service]
# oneshot, so GDM (ordered After= this unit) waits for setup to finish
# instead of racing it. NOT RemainAfterExit: that kept this unit "active"
# for the rest of the first boot, so a kosherd restart (a crash, or a dev
# push with `just deploy-kosherd`) stopped it through Requires=, its stop
# hook below started the tty1 getty, and GDM — which conflicts with that
# getty — went down with the person's whole desktop session. Once the
# wizard has run there is nothing here to keep active: the condition
# above keeps it from running again.
Type=oneshot
# A serial console reports a size of 0x0, and systemd then asks the
# terminal for its size with escape sequences and reads the answer from
# the same line, so whatever the person had typed into the text wizard
# went with it: the password arrived empty and setup never finished. A
# console with a size is not asked. A real screen already has one and is
# left alone.
ExecStartPre=-/bin/sh -c '[ "$$(stty -F /dev/console size 2>/dev/null)" != "0 0" ] || stty -F /dev/console rows 24 cols 80'
ExecStart=/usr/bin/kosher-setup-session
# Generous, because a person is typing into the wizard — but NOT infinite:
# GDM is ordered after this unit, so a wizard that wedges (no usable display,
# a hung compositor) would otherwise leave the machine sitting at the splash
# screen forever with no way to reach a login screen.
TimeoutStartSec=30min
# A real virtual terminal and a real logind session — cage's own kiosk
# recipe. A Wayland compositor needs a VT to take over and a seat that
# grants it the DRM and input devices; logind provides both, but only to a
# process inside a session. The earlier TTYPath=/dev/console gave cage no
# VT at all (in QEMU /dev/console is the serial port), so it sat waiting
# for a seat that never came and the boot froze at the setup banner.
# PAMName opens that session for root on tty1, the same way a login would.
# The TEXT wizard is unaffected: it talks to /dev/console explicitly, so a
# headless or serial machine still gets its prompts where it can see them.
TTYPath=/dev/tty1
PAMName=login
UtmpIdentifier=tty1
UtmpMode=user
StandardInput=tty
# journal+console: a machine whose setup failed has no account to log in
# with and a locked root, so the journal is unreachable. Printing to the
# console is the only way the failure is visible at all.
StandardOutput=journal+console
StandardError=journal+console
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
# Give the console back. Conflicts= stops the getty and nothing restarts
# it on its own, which would leave a serial or headless machine with no
# way to log in after setup finished.
# ...the SERIAL consoles, that is, the ones a headless or test machine
# logs in on. Not getty.target: that pulls in the getty on tty1, which
# the login screen conflicts with, and once this unit stopped staying
# active after the wizard (a daemon restart used to take it down, and
# the login screen with it) the hook ran the moment the wizard finished,
# started that getty, and GDM lost the console — a fresh machine ended
# its first boot at a black text login.
ExecStopPost=-/bin/sh -c 'for c in ttyS0 hvc0; do [ -e "/dev/$c" ] && systemctl --no-block start "serial-getty@$c.service"; done; true'

[Install]
WantedBy=graphical.target
