[Unit]
Description=KosherOS URL filter (mitmproxy, inspect mode)
After=kosher-firewall.service kosher-dns.service network.target systemd-tmpfiles-setup.service
Wants=kosher-dns.service
# Restarted on every policy change; see kosher-dns.service.
StartLimitIntervalSec=0

[Service]
Type=simple
User=kosher-mitm
Group=kosher-mitm
# Transparent mode: nftables redirects inspected users' web traffic here and
# the proxy recovers the original destination from the socket.
# /usr/bin/env so the unit works whether mitmproxy came from the distro
# package or a pip install in a dev VM.
# One listener per filtered user (see kosherd/nft.py mitm_ports): the port
# a connection arrives on tells the proxy whose it is. kosherd writes the
# list to listen.env on every policy apply and restarts this service. The
# Environment= line is the fallback for a first start before any apply.
Environment="MITM_MODES=--mode transparent@127.0.0.1:30000"
EnvironmentFile=-/var/lib/kosher-mitm/listen.env
ExecStart=/usr/bin/env mitmdump \
    $MITM_MODES \
    --set confdir=/var/lib/kosher-mitm \
    --set block_global=false \
    --set termlog_verbosity=warn \
    --set flow_detail=0 \
    --scripts /usr/share/kosher/mitm/kosher_filter.py
Restart=on-failure
RestartSec=2
StateDirectory=kosher-mitm
StateDirectoryMode=0750
# It never reads the policy; kosherd renders uid -> URL rules into
# /var/lib/kosher-mitm/rules.json for it. images.sqlite, beside it, caches
# what the detector concluded about a picture, keyed by content hash — the
# same logo comes back on every page of a site.
ProtectSystem=strict
ReadWritePaths=/var/lib/kosher-mitm
# Drop-only: the service may create an "ask for this page"
# request here, and the directory's own 0730 mode stops it
# reading anyone else's.
ReadWritePaths=-/var/lib/kosher-requests
PrivateTmp=yes
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
