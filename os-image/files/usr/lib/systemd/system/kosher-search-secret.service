[Unit]
Description=Generate the KosherOS search instance secret
Before=kosher-searxng.service
ConditionPathExists=!/var/lib/kosher-search/secret.env

[Service]
Type=oneshot
RemainAfterExit=yes
# The secret signs SearXNG's preference cookies. A value baked into the
# image would be identical on every machine, so it is generated once, here,
# on the machine itself.
ExecStart=/usr/bin/install -d -m 0755 -o kosher-search -g kosher-search /var/lib/kosher-search
ExecStart=/bin/sh -c 'umask 077; printf "SEARXNG_SECRET=%%s\n" "$(head -c 32 /dev/urandom | base64 | tr -d = )" > /var/lib/kosher-search/secret.env'
ExecStart=/usr/bin/chown kosher-search:kosher-search /var/lib/kosher-search/secret.env

[Install]
WantedBy=multi-user.target
