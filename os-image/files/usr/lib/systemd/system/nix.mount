[Unit]
Description=Nix store
# Where a KosherOS machine's Nix store really is. The daemon's units carry
# RequiresMountsFor=/nix/store, so they wait for this.
Requires=kosher-nix-store.service
After=kosher-nix-store.service

[Mount]
What=/var/lib/nix
Where=/nix
Type=none
# Store programs execute, but store files never grant privilege or act as
# device nodes. Mount units do not accept the service sandbox directives.
Options=bind,nosuid,nodev

[Install]
WantedBy=local-fs.target
